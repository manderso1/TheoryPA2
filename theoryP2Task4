import sys

class CFG:
    def __init__(self, terminals, variables, productions):
        self.terminals = terminals 
        self.variables = variables
        self.productions = productions

    def apply_single_product(self, string, index, left):
        
        if left == True:
            for s in range(len(string)):
                if string[s] in self.variables:
                    varArray = self.productions.get(string[s], [])[index]
                    return string[:s] + varArray + string[s+1:]
            return string
        elif left == False:
            for s in range(len(string) -1, -1, - 1):
                if string[s] in self.variables:
                    varArray = self.productions.get(string[s], [])[index]
                    return string[:s] + varArray + string[s+1:]
            return string
        
    def apply_productions(self, string, index_list, left):
        current_string = string
        
        for i in index_list:
           current_string = self.apply_single_product(current_string, i , left)
        return current_string

    def apply_production_pt(self, string, rule_numbers, parse_tree, left):
        if len(rule_numbers) == 0:
            return parse_tree

        self.expand_tree(parse_tree, rule_numbers[0], left)

        new_string = self.apply_single_product(string, rule_numbers[0], left)

        return self.apply_production_pt(new_string, rule_numbers[1:], parse_tree, left)

    def expand_tree(self, node, rule, left):
        if node[1] == []:
            if node[0] in self.variables:
                varArray = self.productions.get(node[0], [])[rule]
                node[1] = [[c, []] for c in varArray]
                return True
            return False
        if left == True:
            children = node[1]
        else:
            children = node[1][::-1]

        for child in children:
            if self.expand_tree(child, rule, left):
                return True
        return False

    def leaves(self, parse_tree):
        if parse_tree[1] == []:
            return [parse_tree[0]]
        result = []
        for child in parse_tree[1]:
            result = result + self.leaves(child)
        return result



def read_from_stdin1():
    terminals = input()
    terminals = eval(terminals)

    variables = sys.stdin.readline()
    variables = eval(variables)

    productions = sys.stdin.readline()
    productions = eval(productions)

    
    return terminals, variables, productions

def read_from_stdin1a():
    terminals, variables, productions = read_from_stdin1()

    mystring = eval(sys.stdin.readline())
    index_list = eval(sys.stdin.readline())
    left = eval(sys.stdin.readline())

    return terminals, variables, productions, mystring, index_list, left

